<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SampleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeatGeekSDKSample"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            SeatGeek SDK's OAuth receiver. The SDK starts it by explicit intent, so it needs no
            intent-filter. In OIDC mode the browser redirect (yourAppScheme://oauth) is caught by
            AppAuth's RedirectUriReceiverActivity, which the SDK bundles and registers for the
            appAuthRedirectScheme placeholder in build.gradle.kts. Do not give this activity an
            intent-filter for that scheme: two activities matching the redirect would break it.
        -->
        <activity
            android:name="com.seatgeek.android.sdk.oauth.SeatGeekOAuthReceiverActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".SeatGeekActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>